# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — never commit it.

# Leave empty to use the local SQLite file (backend/tracker.db).
# Set to a Postgres URL (e.g. Neon) to use a hosted database instead:
# postgresql://user:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Password for the private tracker (the login behind the landing page's lock icon).
# Use something long and random: it is the only thing between the public and your data.
# On Vercel, set this in Project Settings > Environment Variables. If it is missing
# there, every data route answers 503 on purpose. Locally, leaving it empty turns the
# login off so `uvicorn` + `npm run dev` work with no extra setup.
OWNER_PASSWORD=

# Habits tab: habits are read from the newest backup (.db) that the My Habits app exports to a Google
# Drive folder. Share that folder with a Google service account as Viewer, then set both:
#   GOOGLE_DRIVE_FOLDER_ID: the last part of the folder's URL
#   GOOGLE_SERVICE_ACCOUNT_JSON: the key file's JSON, or that JSON base64-encoded
# (the same two the Habits-Tracking site uses). Leave empty and the Habits tab says it isn't set up.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
