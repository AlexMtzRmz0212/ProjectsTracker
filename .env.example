# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — never commit it.

# Leave empty to use the local SQLite file (backend/tracker.db).
# Set to a Postgres URL (e.g. Neon) to use a hosted database instead:
# postgresql://user:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Accounts. Each person has their own email + password and their own private data. Signup is by
# invite: the admin makes invite links in the app (menu > Account).
#
# SESSION_SECRET signs the login cookies. Use something long and random, and keep it secret:
# anyone who has it can forge a login. On Vercel, set it in Project Settings > Environment
# Variables. If it is missing there, every data route answers 503 on purpose. Locally it may be
# left empty (a fixed development key is used).
SESSION_SECRET=

# The first admin is made from these two when the database has no accounts yet. If you used the
# single-owner version, this is how you keep your data: it all becomes this account's, and you sign
# in with the password you already had. After that they are ignored (change the password in the app).
# Locally you need both to be able to sign in at all.
ADMIN_EMAIL=
OWNER_PASSWORD=

# Habits tab: habits are read from the newest backup (.db) that the My Habits app exports to a Google
# Drive folder. Share that folder with a Google service account as Viewer, then set both:
#   GOOGLE_DRIVE_FOLDER_ID: the last part of the folder's URL
#   GOOGLE_SERVICE_ACCOUNT_JSON: the key file's JSON, or that JSON base64-encoded
# (the same two the Habits-Tracking site uses). Leave empty and the Habits tab says it isn't set up.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
